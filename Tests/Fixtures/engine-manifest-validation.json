{
  "base": {
    "id": "custom-engine-r1",
    "displayName": "Custom engine",
    "arch": "x86_64",
    "minMacOS": "14.0",
    "components": {
      "wine": {
        "kind": "engine",
        "url": "https://archives.example/wine.tar.gz",
        "sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        "extract": {"subpath": "engine", "into": "engine"}
      }
    }
  },
  "cases": [
    {"name": "renderer-specific app defaults", "valid": true, "changes": [{"path": ["rendererAppDefaults"], "value": {"d3dmetal": {"steamwebhelper.exe": {"CommandLineAppend": "--in-process-gpu"}}}}]},
    {"name": "null renderer app defaults", "valid": true, "changes": [{"path": ["rendererAppDefaults"], "value": null}]},
    {"name": "renderer app defaults must be an object", "valid": false, "changes": [{"path": ["rendererAppDefaults"], "value": []}]},
    {"name": "renderer defaults require an executable map", "valid": false, "changes": [{"path": ["rendererAppDefaults"], "value": {"d3dmetal": "--in-process-gpu"}}]},
    {"name": "renderer registry values must be strings", "valid": false, "changes": [{"path": ["rendererAppDefaults"], "value": {"d3dmetal": {"steamwebhelper.exe": {"CommandLineAppend": true}}}}]},
    {"name": "minimal complete manifest", "valid": true, "changes": []},
    {"name": "native arm64", "valid": true, "changes": [{"path": ["arch"], "value": "arm64"}]},
    {"name": "third party HTTP endpoint", "valid": true, "changes": [{"path": ["components", "wine", "url"], "value": "http://localhost:8000/archive?build=42"}]},
    {"name": "absolute local archive", "valid": true, "changes": [{"path": ["components", "wine", "url"], "value": "file:///tmp/local%20wine.tar.gz"}]},
    {"name": "localhost file archive", "valid": true, "changes": [{"path": ["components", "wine", "url"], "value": "file://localhost/tmp/wine.tar.gz"}]},
    {"name": "uppercase checksum", "valid": true, "changes": [{"path": ["components", "wine", "sha256"], "value": "ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789"}]},
    {"name": "major version only", "valid": true, "changes": [{"path": ["minMacOS"], "value": "14"}]},
    {"name": "patch version", "valid": true, "changes": [{"path": ["minMacOS"], "value": "14.0.1"}]},
    {"name": "compatible extra metadata", "valid": true, "changes": [{"path": ["futureMetadata"], "value": {"anything": true}}, {"path": ["components", "wine", "layout"], "value": ["bin/* -> prose"]}, {"path": ["verified"], "value": {"result": "informational"}}]},
    {"name": "nullable optional fields", "valid": true, "changes": [{"path": ["components", "wine", "optional"], "value": null}, {"path": ["components", "wine", "size"], "value": null}, {"path": ["channel"], "value": null}]},
    {"name": "legacy selector precedence", "valid": true, "changes": [{"path": ["components", "wine", "extract", "strip"], "value": "legacy"}]},
    {"name": "zero download size", "valid": true, "changes": [{"path": ["components", "wine", "size"], "value": 0}]},
    {"name": "no ID", "valid": false, "changes": [{"path": ["id"], "remove": true}]},
    {"name": "empty ID", "valid": false, "changes": [{"path": ["id"], "value": ""}]},
    {"name": "hidden ID", "valid": false, "changes": [{"path": ["id"], "value": ".hidden"}]},
    {"name": "escaping ID", "valid": false, "changes": [{"path": ["id"], "value": "../escape"}]},
    {"name": "ID newline", "valid": false, "changes": [{"path": ["id"], "value": "engine\n"}]},
    {"name": "blank display name", "valid": false, "changes": [{"path": ["displayName"], "value": " \n\t"}]},
    {"name": "unsupported architecture", "valid": false, "changes": [{"path": ["arch"], "value": "unknown"}]},
    {"name": "empty macOS floor", "valid": false, "changes": [{"path": ["minMacOS"], "value": ""}]},
    {"name": "nonnumeric macOS floor", "valid": false, "changes": [{"path": ["minMacOS"], "value": "latest"}]},
    {"name": "negative macOS floor", "valid": false, "changes": [{"path": ["minMacOS"], "value": "-1.0"}]},
    {"name": "macOS floor empty segment", "valid": false, "changes": [{"path": ["minMacOS"], "value": "14..0"}]},
    {"name": "too many macOS components", "valid": false, "changes": [{"path": ["minMacOS"], "value": "14.0.0.1"}]},
    {"name": "macOS floor newline", "valid": false, "changes": [{"path": ["minMacOS"], "value": "14.0\n"}]},
    {"name": "no Wine component", "valid": false, "changes": [{"path": ["components", "wine"], "remove": true}]},
    {"name": "Wine is optional", "valid": false, "changes": [{"path": ["components", "wine", "optional"], "value": true}]},
    {"name": "Wine wrong kind", "valid": false, "changes": [{"path": ["components", "wine", "kind"], "value": "renderer"}]},
    {"name": "Wine missing extraction", "valid": false, "changes": [{"path": ["components", "wine", "extract"], "remove": true}]},
    {"name": "Wine null extraction", "valid": false, "changes": [{"path": ["components", "wine", "extract"], "value": null}]},
    {"name": "Wine wrong destination", "valid": false, "changes": [{"path": ["components", "wine", "extract", "into"], "value": "renderers/wine"}]},
    {"name": "escaping component name", "valid": false, "changes": [{"path": ["components", "../escape"], "value": {"kind": "tool", "url": "https://example.org/tool", "sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"}}]},
    {"name": "unsupported component kind", "valid": false, "changes": [{"path": ["components", "addon"], "value": {"kind": "unknown", "url": "https://example.org/addon", "sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"}}]},
    {"name": "relative archive URL", "valid": false, "changes": [{"path": ["components", "wine", "url"], "value": "wine.tar.gz"}]},
    {"name": "unsupported archive scheme", "valid": false, "changes": [{"path": ["components", "wine", "url"], "value": "ftp://example.org/wine.tar.gz"}]},
    {"name": "archive URL without a host", "valid": false, "changes": [{"path": ["components", "wine", "url"], "value": "https:///wine.tar.gz"}]},
    {"name": "relative file archive", "valid": false, "changes": [{"path": ["components", "wine", "url"], "value": "file:relative.tar.gz"}]},
    {"name": "remote file archive", "valid": false, "changes": [{"path": ["components", "wine", "url"], "value": "file://server/tmp/wine.tar.gz"}]},
    {"name": "short checksum", "valid": false, "changes": [{"path": ["components", "wine", "sha256"], "value": "a"}]},
    {"name": "nonhexadecimal checksum", "valid": false, "changes": [{"path": ["components", "wine", "sha256"], "value": "gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg"}]},
    {"name": "checksum newline", "valid": false, "changes": [{"path": ["components", "wine", "sha256"], "value": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\n"}]},
    {"name": "negative component size", "valid": false, "changes": [{"path": ["components", "wine", "size"], "value": -1}]},
    {"name": "absolute extraction path", "valid": false, "changes": [{"path": ["components", "wine", "extract", "subpath"], "value": "/tmp/engine"}]},
    {"name": "parent extraction segment", "valid": false, "changes": [{"path": ["components", "wine", "extract", "subpath"], "value": "engine/../outside"}]},
    {"name": "backslash extraction path", "valid": false, "changes": [{"path": ["components", "wine", "extract", "subpath"], "value": "engine\\outside"}]},
    {"name": "empty extraction path", "valid": false, "changes": [{"path": ["components", "wine", "extract", "subpath"], "value": ""}]},
    {"name": "NUL extraction path", "valid": false, "changes": [{"path": ["components", "wine", "extract", "subpath"], "value": "engine\u0000"}]},
    {"name": "unsafe legacy selector", "valid": false, "changes": [{"path": ["components", "wine", "extract", "strip"], "value": "../outside"}]}
  ]
}
