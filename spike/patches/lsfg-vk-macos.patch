diff --git a/macos/check-core.cpp b/macos/check-core.cpp
new file mode 100644
index 0000000..b1848fb
--- /dev/null
+++ b/macos/check-core.cpp
@@ -0,0 +1,55 @@
+// check feature copies and config reloads without a display
+#include "device_chain.hpp"
+#include "lsfg-vk-utils/config.hpp"
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+static void check(bool condition, const char* message) { if (!condition) throw std::runtime_error(message); }
+int main() {
+    using namespace lsfgvk;
+    VkPhysicalDeviceVulkan12Features f12{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES};
+    VkPhysicalDeviceSynchronization2Features sync{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SYNCHRONIZATION_2_FEATURES, &f12};
+    layer::DeviceChain copy(&sync);
+    auto* copiedSync = static_cast<VkPhysicalDeviceSynchronization2Features*>(copy.head());
+    auto* copied12 = static_cast<VkPhysicalDeviceVulkan12Features*>(copiedSync->pNext);
+    copiedSync->synchronization2 = VK_TRUE; copied12->timelineSemaphore = VK_TRUE;
+    check(!sync.synchronization2 && !f12.timelineSemaphore && sync.pNext == &f12, "Device chain mutated its caller");
+    check(copiedSync != &sync && copied12 != &f12 && copied12->pNext == nullptr, "Device chain was not fully copied");
+    char dir[] = "/tmp/lsfg-core-XXXXXX";
+    check(mkdtemp(dir), "mkdtemp failed");
+    struct Cleanup { const char* dir; ~Cleanup() { std::filesystem::remove_all(dir); } } cleanup{dir};
+    auto path = std::filesystem::path(dir) / "conf.toml";
+    utils::Configuration config; config.profiles.push_back(utils::Profile{.name = "audit"});
+    utils::writeConfig(path, config);
+    utils::ConfigWatcher watcher(path);
+    check(!watcher.checkAndReload(), "Unchanged configuration reloaded");
+    config.profiles[0].multiplier = 3; utils::writeConfig(path, config);
+    const timespec future[2] = {{2208988800, 0}, {2208988800, 1}};
+    check(utimensat(AT_FDCWD, path.c_str(), future, 0) == 0, "Future mtime failed");
+    auto changed = watcher.checkAndReload();
+    check(changed && changed->profiles[0].multiplier == 3, "Post-2038 configuration was ignored");
+    std::ofstream(path) << "invalid toml = [";
+    bool failed = false;
+    try { (void)watcher.checkAndReload(); } catch (...) { failed = true; }
+    check(failed, "Invalid configuration was accepted");
+    struct stat invalidTime{}; stat(path.c_str(), &invalidTime);
+    config.profiles[0].multiplier = 2; utils::writeConfig(path, config);
+    const timespec same[2] = {invalidTime.st_atimespec, invalidTime.st_mtimespec};
+    check(utimensat(AT_FDCWD, path.c_str(), same, 0) == 0, "mtime restore failed");
+    changed = watcher.checkAndReload();
+    check(changed && changed->profiles[0].multiplier == 2, "Failed reload consumed the update timestamp");
+    setenv("LSFGVK_ENV", "1", 1);
+    for (const char* invalid : {"4294967298", "2junk", "-1", "5"}) {
+        setenv("LSFGVK_MULTIPLIER", invalid, 1);
+        bool rejected = false;
+        try { (void)utils::getOrDefault(); } catch (...) { rejected = true; }
+        check(rejected, "Malformed or unsupported multiplier accepted");
+    }
+    unsetenv("LSFGVK_ENV"); unsetenv("LSFGVK_MULTIPLIER");
+    std::cout << "Device-chain and config-reload regression checks passed\n";
+}
diff --git a/macos/d3dclear-win32.c b/macos/d3dclear-win32.c
new file mode 100644
index 0000000..30268c0
--- /dev/null
+++ b/macos/d3dclear-win32.c
@@ -0,0 +1,50 @@
+// test d3d11 presentation through wine and dxvk
+#define WIN32_LEAN_AND_MEAN
+#define COBJMACROS
+#include <windows.h>
+#include <d3d11.h>
+#include <dxgi.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define CHECK(x) do { HRESULT hr_ = (x); if (FAILED(hr_)) { fprintf(stderr, "%s failed: 0x%08lx\n", #x, (unsigned long)hr_); fflush(stderr); exit(2); } } while (0)
+
+static LRESULT CALLBACK wndproc(HWND h, UINT m, WPARAM w, LPARAM l) {
+    if (m == WM_CLOSE || m == WM_DESTROY) { PostQuitMessage(0); return 0; }
+    return DefWindowProcA(h, m, w, l);
+}
+
+int main(int argc, char** argv) {
+    int frames = argc > 1 ? atoi(argv[1]) : 240;
+    setvbuf(stdout, NULL, _IONBF, 0);
+    WNDCLASSA wc = {0}; wc.lpfnWndProc = wndproc; wc.hInstance = GetModuleHandleA(NULL); wc.lpszClassName = "d3dclear";
+    RegisterClassA(&wc);
+    HWND hwnd = CreateWindowExA(0, "d3dclear", "d3dclear-win32", WS_OVERLAPPEDWINDOW | WS_VISIBLE, 100, 100, 640, 480, NULL, NULL, wc.hInstance, NULL);
+
+    DXGI_SWAP_CHAIN_DESC sd = {0};
+    sd.BufferCount = 2; sd.BufferDesc.Width = 640; sd.BufferDesc.Height = 480; sd.BufferDesc.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    sd.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT; sd.OutputWindow = hwnd; sd.SampleDesc.Count = 1; sd.Windowed = TRUE;
+    sd.SwapEffect = DXGI_SWAP_EFFECT_DISCARD;
+    ID3D11Device* dev; ID3D11DeviceContext* ctx; IDXGISwapChain* sc; D3D_FEATURE_LEVEL fl;
+    CHECK(D3D11CreateDeviceAndSwapChain(NULL, D3D_DRIVER_TYPE_HARDWARE, NULL, 0, NULL, 0, D3D11_SDK_VERSION, &sd, &sc, &dev, &fl, &ctx));
+    printf("d3d11 device ok, feature level 0x%x\n", fl);
+
+    LARGE_INTEGER freq, t0, t1; QueryPerformanceFrequency(&freq); QueryPerformanceCounter(&t0);
+    int presented = 0;
+    for (int f = 0; f < frames; f++) {
+        MSG msg; while (PeekMessageA(&msg, NULL, 0, 0, PM_REMOVE)) { if (msg.message == WM_QUIT) goto done_loop; TranslateMessage(&msg); DispatchMessageA(&msg); }
+        ID3D11Texture2D* bb; CHECK(IDXGISwapChain_GetBuffer(sc, 0, &IID_ID3D11Texture2D, (void**)&bb));
+        ID3D11RenderTargetView* rtv; CHECK(ID3D11Device_CreateRenderTargetView(dev, (ID3D11Resource*)bb, NULL, &rtv));
+        float t = (float)(f % 120) / 120.0f;
+        float color[4] = { t, 1.0f - t, (f & 1) ? 0.9f : 0.1f, 1.0f };
+        ID3D11DeviceContext_ClearRenderTargetView(ctx, rtv, color);
+        ID3D11RenderTargetView_Release(rtv); ID3D11Texture2D_Release(bb);
+        CHECK(IDXGISwapChain_Present(sc, 1, 0));
+        presented++;
+    }
+done_loop:
+    QueryPerformanceCounter(&t1);
+    double secs = (double)(t1.QuadPart - t0.QuadPart) / (double)freq.QuadPart;
+    printf("RESULT app_frames=%d seconds=%.2f app_fps=%.1f\n", presented, secs, presented / secs);
+    return 0;
+}
diff --git a/macos/generate-device-chain.py b/macos/generate-device-chain.py
new file mode 100644
index 0000000..bc52510
--- /dev/null
+++ b/macos/generate-device-chain.py
@@ -0,0 +1,19 @@
+#!/usr/bin/env python3
+"""Generate sizes for the pinned Vulkan headers' device-create pNext structures."""
+import pathlib, re, sys
+source = pathlib.Path(sys.argv[1]).read_text().splitlines()
+# preserve guards from the generated declarations
+start = next(i for i, line in enumerate(source) if "struct StructExtends<" in line)
+end = max(i for i, line in enumerate(source) if "struct StructExtends<" in line)
+output = ["// generated from vendored headers"]
+for line in source[start:end + 1]:
+    if re.match(r"\s*#\s*(if|else|elif|endif)\b", line):
+        output.append(line)
+    match = re.search(r"struct StructExtends<([^,]+), DeviceCreateInfo>", line)
+    if match:
+        name = match[1].strip()
+        output.append(f"case vk::{name}::structureType: return sizeof(vk::{name});")
+# close remaining guards
+level = sum(bool(re.match(r"\s*#\s*if(?:def|ndef)?\b", line)) - bool(re.match(r"\s*#\s*endif\b", line)) for line in output)
+output += ["#endif"] * level
+pathlib.Path(sys.argv[2]).write_text("\n".join(output) + "\n")
diff --git a/macos/test-driver.cpp b/macos/test-driver.cpp
new file mode 100644
index 0000000..49e1b4f
--- /dev/null
+++ b/macos/test-driver.cpp
@@ -0,0 +1,80 @@
+// check submissions and inject acquire failures
+#include <vulkan/vulkan.h>
+#include <dlfcn.h>
+#include <cstdlib>
+#include <cstring>
+#include <cstdio>
+#include <vector>
+#include <unordered_map>
+static PFN_vkGetInstanceProcAddr driverGIPA;
+static PFN_vkGetDeviceProcAddr driverGDPA;
+static PFN_vkQueueSubmit driverSubmit;
+static PFN_vkAcquireNextImageKHR driverAcquire;
+static PFN_vkCreateSemaphore driverCreateSemaphore;
+static PFN_vkDestroySemaphore driverDestroySemaphore;
+static std::unordered_map<VkSemaphore, bool> timeline;
+extern "C" PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char*);
+extern "C" PFN_vkVoidFunction vkGetDeviceProcAddr(VkDevice, const char*);
+static void init() {
+    if (driverGIPA) return;
+    auto lib = dlopen(std::getenv("VKTEST_REAL_DRIVER"), RTLD_NOW | RTLD_LOCAL);
+    if (!lib) { std::fprintf(stderr, "test driver load failed: %s\n", dlerror()); std::abort(); }
+    driverGIPA = reinterpret_cast<PFN_vkGetInstanceProcAddr>(dlsym(lib, "vkGetInstanceProcAddr"));
+    driverGDPA = reinterpret_cast<PFN_vkGetDeviceProcAddr>(dlsym(lib, "vkGetDeviceProcAddr"));
+}
+static VkResult createSemaphore(VkDevice device, const VkSemaphoreCreateInfo* info, const VkAllocationCallbacks* alloc, VkSemaphore* semaphore) {
+    const auto result = driverCreateSemaphore(device, info, alloc, semaphore);
+    if (result == VK_SUCCESS) {
+        bool isTimeline = false;
+        for (auto node = static_cast<const VkBaseInStructure*>(info->pNext); node; node = node->pNext)
+            if (node->sType == VK_STRUCTURE_TYPE_SEMAPHORE_TYPE_CREATE_INFO)
+                isTimeline = reinterpret_cast<const VkSemaphoreTypeCreateInfo*>(node)->semaphoreType == VK_SEMAPHORE_TYPE_TIMELINE;
+        timeline[*semaphore] = isTimeline;
+    }
+    return result;
+}
+static void destroySemaphore(VkDevice device, VkSemaphore semaphore, const VkAllocationCallbacks* alloc) {
+    timeline.erase(semaphore); driverDestroySemaphore(device, semaphore, alloc);
+}
+static VkResult submit(VkQueue queue, uint32_t count, const VkSubmitInfo* submits, VkFence fence) {
+    for (uint32_t i = 0; i < count; ++i) {
+        const auto& info = submits[i];
+        const VkTimelineSemaphoreSubmitInfo* values = nullptr;
+        for (auto node = static_cast<const VkBaseInStructure*>(info.pNext); node; node = node->pNext)
+            if (node->sType == VK_STRUCTURE_TYPE_TIMELINE_SEMAPHORE_SUBMIT_INFO)
+                values = reinterpret_cast<const VkTimelineSemaphoreSubmitInfo*>(node);
+        auto check = [&](uint32_t n, const VkSemaphore* semaphores, uint32_t m, const uint64_t* numbers) {
+            bool anyTimeline = false;
+            for (uint32_t j = 0; j < n; ++j) anyTimeline |= timeline[semaphores[j]];
+            if (anyTimeline && (n != m || !numbers)) { std::fputs("INVALID_TIMELINE_COUNTS\n", stderr); std::abort(); }
+            // read all declared values, including binary entries
+            for (uint32_t j = 0; j < m; ++j) { volatile uint64_t value = numbers[j]; (void)value; }
+        };
+        check(info.waitSemaphoreCount, info.pWaitSemaphores, values ? values->waitSemaphoreValueCount : 0, values ? values->pWaitSemaphoreValues : nullptr);
+        check(info.signalSemaphoreCount, info.pSignalSemaphores, values ? values->signalSemaphoreValueCount : 0, values ? values->pSignalSemaphoreValues : nullptr);
+    }
+    return driverSubmit(queue, count, submits, fence);
+}
+static VkResult acquire(VkDevice device, VkSwapchainKHR chain, uint64_t timeout, VkSemaphore semaphore, VkFence fence, uint32_t* index) {
+    static int calls = 0;
+    ++calls;
+    const char* failAt = std::getenv("VKTEST_FAIL_ACQUIRE_AT");
+    if (failAt && calls == std::atoi(failAt)) {
+        std::fputs("INJECTED_OUT_OF_DATE\n", stderr); return VK_ERROR_OUT_OF_DATE_KHR;
+    }
+    return driverAcquire(device, chain, timeout, semaphore, fence, index);
+}
+static PFN_vkVoidFunction wrap(const char* name, PFN_vkVoidFunction actual) {
+    if (!actual) return nullptr;
+#define WRAP(vkname, variable, wrapper) if (std::strcmp(name, #vkname) == 0) { variable = reinterpret_cast<PFN_##vkname>(actual); return reinterpret_cast<PFN_vkVoidFunction>(wrapper); }
+    WRAP(vkQueueSubmit, driverSubmit, submit)
+    WRAP(vkAcquireNextImageKHR, driverAcquire, acquire)
+    WRAP(vkCreateSemaphore, driverCreateSemaphore, createSemaphore)
+    WRAP(vkDestroySemaphore, driverDestroySemaphore, destroySemaphore)
+#undef WRAP
+    if (std::strcmp(name, "vkGetInstanceProcAddr") == 0) return reinterpret_cast<PFN_vkVoidFunction>(vkGetInstanceProcAddr);
+    if (std::strcmp(name, "vkGetDeviceProcAddr") == 0) return reinterpret_cast<PFN_vkVoidFunction>(vkGetDeviceProcAddr);
+    return actual;
+}
+extern "C" PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance instance, const char* name) { init(); return wrap(name, driverGIPA(instance, name)); }
+extern "C" PFN_vkVoidFunction vkGetDeviceProcAddr(VkDevice device, const char* name) { init(); return wrap(name, driverGDPA(device, name)); }
diff --git a/macos/vkclear-win32.c b/macos/vkclear-win32.c
new file mode 100644
index 0000000..626ce21
--- /dev/null
+++ b/macos/vkclear-win32.c
@@ -0,0 +1,133 @@
+// test vulkan presentation through wine
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <stdio.h>
+#include <stdlib.h>
+#define VK_NO_PROTOTYPES
+#define VK_USE_PLATFORM_WIN32_KHR
+#include <vulkan/vulkan.h>
+
+#define CHECK(x) do { VkResult r_ = (x); if (r_ != VK_SUCCESS && r_ != VK_SUBOPTIMAL_KHR) { fprintf(stderr, "%s failed: %d\n", #x, r_); fflush(stderr); exit(2); } } while (0)
+
+static LRESULT CALLBACK wndproc(HWND h, UINT m, WPARAM w, LPARAM l) {
