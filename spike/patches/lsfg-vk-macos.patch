+    void initShim() {
+        static std::once_flag once;
+        std::call_once(once, []() {
+            const std::string path{realDriverPath()};
+            void* handle{path.empty() ? nullptr : dlopen(path.c_str(), RTLD_NOW | RTLD_LOCAL)};
+            if (!handle) {
+                const char* error = dlerror();
+                LOG(Error) << "lsfg-vk shim: cannot load real MoltenVK from '" << path
