+            copy->pNext = nullptr;
+            if (tail) tail->pNext = copy;
+            else m_head = copy;
+            tail = copy;
+            m_nodes.push_back(std::move(storage));
+        }
+    }
+    void* head() const { return m_head; }
+private:
+    static size_t size(VkStructureType type) {
+        switch (static_cast<vk::StructureType>(type)) {
+#include "device-chain-sizes.inc"
+            default: throw std::runtime_error("Unrecognized device feature chain; using passthrough");
+        }
+    }
+    VkBaseOutStructure* m_head{nullptr};
+    std::vector<std::unique_ptr<unsigned char[]>> m_nodes;
+};
+}
diff --git a/macos/README.md b/macos/README.md
new file mode 100644
index 0000000..ad8cf0e
--- /dev/null
+++ b/macos/README.md
@@ -0,0 +1,103 @@
+# lsfg-vk on macOS (MoltenVK shim)
+
+Lossless Scaling frame generation for Windows games running under Wine on Apple Silicon,
+through Highball's DXVK / vkd3d-proton graphics modes. Same pipeline and shaders as the Linux
+layer; what changes is how it attaches to the game and how it shares images.
+
+## Why a shim, not a layer
+
+Wine on macOS does not use the Khronos Vulkan loader. `win32u.so` does
+`dlopen("libMoltenVK.dylib")` and `dlsym`s `vkGetInstanceProcAddr` / `vkGetDeviceProcAddr`;
+`winemac.so` also `dlsym`s `vkCreateMetalSurfaceEXT` and `vkCreateMacOSSurfaceMVK`. There is no
+layer mechanism in that chain. So `lsfg-vk-layer` is built here as `libMoltenVK.dylib`
+(target `lsfg-vk-shim`, `-DLSFGVK_SHIM`): it exports those four symbols, loads the real MoltenVK
+and forwards everything except the hooks the layer already had (instance, device, swapchain,
+present). Without a profile it is a transparent passthrough.
+
+The launcher puts the shim's directory on `DYLD_LIBRARY_PATH` for a launch that wants frame
+generation. Two dyld facts shaped this:
+
+- `DYLD_FALLBACK_LIBRARY_PATH` is not enough: `win32u.so` carries `LC_RPATH @loader_path/../../`
+  and the engine has `engine/lib/libMoltenVK.dylib` there, and rpath is searched before the
+  fallback path.
+- `DYLD_LIBRARY_PATH` overrides *by leaf name, absolute paths included*. The shim therefore must
+  load the real driver under a different name: `libMoltenVK.real.dylib`, a symlink beside it
+  (`$LSFGVK_MOLTENVK` overrides). Loading `.../frameworks/libMoltenVK.dylib` returns the shim
+  itself and recurses until the stack is gone.
+
+## Single-device mode
+
+MoltenVK has no `VK_KHR_external_memory_fd` / `external_semaphore_fd`, so the Linux design of a
+private device sharing images by fd cannot work. On Apple the pipeline adopts the game's device
+(`lsfgvk::Instance` adopt constructor, `Context::_handles()`), and the device hook enables
+`synchronization2`, `timelineSemaphore` and `shaderFloat16` on it, on whatever feature structs
+the game already chains (DXVK uses `VkPhysicalDeviceVulkan12/13Features`).
+
+One queue means in-order execution: `ContextWrapper::acquire` submits the pipeline's main pass
+*before* the copy that waits on it (upstream does the opposite, which is fine across two queues
+and a guaranteed GPU timeout on one).
+
+## Other macOS changes
+
+- `config.cpp`: no inotify (a `stat()` mtime poll), no `/proc` (profiles come from
+  `LSFGVK_ENV` / `LSFGVK_PROFILE` / `SteamAppId`).
+- `vkhelper.cpp` / `pipeline.cpp`: no fd export structs.
+- `CMakeLists`: `AppleClang` gets `-fconstexpr-steps` too (the pipeline signature is consteval).
+
+## Shaders
+
+`lsfg-vk.dll` from the user's Steam install of Lossless Scaling, **`lsfg-vk` beta branch**
+(the regular build's `Lossless.dll` holds DXBC, not SPIR-V). All 99 modules compile through
+MoltenVK; `lsfg-vk-cli benchmark` on an M2 does 1280×720 ×2 at ~8.3 ms per generated frame.
+
+## Build
+
+    cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_OSX_ARCHITECTURES=x86_64
+    ninja -C build lsfg-vk-shim lsfg-vk-cli     # build/lsfg-vk-layer/libMoltenVK.dylib
+
+x86_64 because Wine and the engine's MoltenVK run under Rosetta. Highball packages it with
+`Scripts/build-lsfg.sh` into the `lsfg` engine component.
+
+## Testing without a game
+
+- `macos/vkclear.mm` (native) and `macos/vkclear-win32.c`, `macos/d3dclear-win32.c` (Wine,
+  mingw-w64): clear-and-present loops that print their app frame rate. With a vsync-paced
+  swapchain and `LSFGVK_MULTIPLIER=2` the app rate halves; that is the generated frames being
+  presented in between.
+- Run the native one with `DYLD_LIBRARY_PATH=<shim dir>` and `LSFGVK_MOLTENVK=<real dylib>`.
+  Do not wrap it in `arch`, `env`, `perl` or any other system binary: those are SIP-restricted
+  and strip `DYLD_*` from the environment.
+
+## Reliability checks and supported presentation
+
+The shim copies the complete device feature chain before enabling features. It picks a
+requested graphics/compute queue, creates the pipeline lazily inside presentation, and drains
+hidden work before returning from that call. Application queue submissions remain untouched.
+This serializes generation with that queue; no background access to a borrowed application
+queue is permitted. Shader-loading failures keep rendering through passthrough.
+
+Generation currently supports single-layer SDR RGBA8/BGRA8 swapchains on the adopted queue.
+HDR/protected/multilayer swapchains, multi-swapchain presents, other queues, and presentation
+extension payloads retain native presentation. They must not be advertised as tested frame
+generation modes. Multipliers 2–4 are supported; 1 disables generation.
+
+`lsfg-vk-macos-check` / CTest check caller-owned feature chains and configuration reloads
+(including post-2038 timestamps and retrying an invalid file). `macos/vkclear.mm` checks caller
+features, presents, and explicitly destroys Vulkan resources. It accepts `VKTEST_RECREATE=1`,
+`VKTEST_MULTI=1`, and `VKTEST_WIDTH`/`VKTEST_HEIGHT`. `macos/test-driver.cpp` is a test-only proxy
+that validates timeline array counts and can inject an out-of-date acquire with
+`VKTEST_FAIL_ACQUIRE_AT`; do not package that proxy as the engine driver.
+
+The full Xcode application is not required to compile the C++ shim. Highball's app can also be
+built locally with the installed 26.5 SDK when the default 27 SDK needs unavailable SwiftUI
+macro plugins; see Highball's `spike/lsfg-macos.md`.
+
+## Confirming frame generation
+
+Enable `LSFGVK_STATS=1` for diagnostic logs. Every 60 successful original presents,
+the shim logs the process ID and cumulative original/generated/total presents for that
+swapchain. At 2x, 60 originals should accompany 60 generated frames; at 3x, 120 generated.
+These count successful driver present calls, not a claim about interpolation quality.
+Also enable `DXVK_HUD=fps` alongside `MTL_HUD_ENABLED=1` to compare the game's source
+frame rate against Metal presentation FPS. On a vsynced 60 Hz display, 2x typically
+shows about 30 source FPS and 60 presented FPS. A lone 60 FPS counter is not proof.
