+// copy chain nodes; borrow nested data only during device creation
+class DeviceChain {
+public:
+    explicit DeviceChain(const void* head) {
+        VkBaseOutStructure* tail = nullptr;
+        for (auto* node = static_cast<const VkBaseInStructure*>(head); node; node = node->pNext) {
+            const size_t bytes = size(node->sType);
