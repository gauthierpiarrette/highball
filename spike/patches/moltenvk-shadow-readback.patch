 void MVKDeviceMemory::syncShadowToDevice() {
-	if (_pShadowHost && _mtlBuffer) { memcpy(_mtlBuffer.contents, _pShadowHost, _shadowLen); }
+	if ( !(_pShadowHost && _mtlBuffer) ) { return; }
+	uint8_t* dst = (uint8_t*)_mtlBuffer.contents;
+	const uint8_t* src = (const uint8_t*)_pShadowHost;
+	std::lock_guard<std::mutex> lock(_shadowRangesLock);
+	if (_pendingGPUWrites.empty()) { memcpy(dst, src, _shadowLen); return; }
+	// HIGHBALL shadow-readback: copy around the ranges a submission still in flight writes.
+	auto pending = _pendingGPUWrites;
+	std::sort(pending.begin(), pending.end());
+	VkDeviceSize pos = 0;
+	for (auto& r : pending) {
+		VkDeviceSize start = std::min<VkDeviceSize>(r.first, _shadowLen);
+		VkDeviceSize end = std::min<VkDeviceSize>(r.first + r.second, _shadowLen);
+		if (start > pos) { memcpy(dst + pos, src + pos, start - pos); }
+		pos = std::max(pos, end);
+	}
+	if (pos < _shadowLen) { memcpy(dst + pos, src + pos, _shadowLen - pos); }
+}
+
+void MVKDeviceMemory::addPendingGPUWrite(VkDeviceSize offset, VkDeviceSize length) {
+	if ( !_pShadowHost || offset >= _shadowLen || length == 0 ) { return; }
+	length = std::min<VkDeviceSize>(length, _shadowLen - offset);
+	static std::atomic<bool> logged(false);
+	if ( !logged.exchange(true) ) {
+		MVKLogInfo("HIGHBALL shadow-readback: GPU writes into imported host memory are copied back when their submission completes.");
+	}
+	std::lock_guard<std::mutex> lock(_shadowRangesLock);
+	_pendingGPUWrites.emplace_back(offset, length);
+}
+
+void MVKDeviceMemory::completeGPUWrite(VkDeviceSize offset, VkDeviceSize length) {
+	if ( !(_pShadowHost && _mtlBuffer) || offset >= _shadowLen || length == 0 ) { return; }
+	length = std::min<VkDeviceSize>(length, _shadowLen - offset);
+	std::lock_guard<std::mutex> lock(_shadowRangesLock);
+	memcpy((uint8_t*)_pShadowHost + offset, (const uint8_t*)_mtlBuffer.contents + offset, length);
+	for (auto it = _pendingGPUWrites.begin(); it != _pendingGPUWrites.end(); ++it) {
+		if (it->first == offset && it->second == length) { _pendingGPUWrites.erase(it); break; }
+	}
 }
 
