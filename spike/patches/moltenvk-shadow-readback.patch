+// HIGHBALL shadow-readback: a write into host memory imported under MVK_SHADOW_IMPORT lands in the
+// private MTLBuffer, so the range is kept from the next upload and copied back on completion.
+void MVKCommandEncoder::recordShadowWrite(MVKBuffer* buffer, VkDeviceSize mtlBufferOffset, VkDeviceSize length) {
+	if ( !buffer || !_pEncodingContext || !_pEncodingContext->tracksShadowWrites || length == 0 ) { return; }
+	MVKDeviceMemory* mem = buffer->getDeviceMemory();
+	if ( !mem || !mem->isShadowed() || mem->getMTLHeap() ) { return; }
+	mem->addPendingGPUWrite(mtlBufferOffset, length);
+	_pEncodingContext->shadowWrites.emplace_back(mem, mtlBufferOffset, length);
+}
